# ==============================================================================
# Mundial 2026 Predictor - Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual API keys.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# --- football-data.org API ---
# Get your free key at: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here

# --- api-football.com API ---
# Get your free key at: https://dashboard.api-football.com/register
API_FOOTBALL_KEY=your_api_football_key_here

# --- Optional: Transfermarkt scraping ---
TRANSFERMARKT_USER_AGENT="Mozilla/5.0 (research project)"

# --- Optional: ORCID for paper citation ---
ORCID_ID=0000-0000-0000-0000

# --- Streamlit deployment ---
STREAMLIT_DEPLOY_TOKEN=optional_for_deploy

# --- Project metadata ---
PROJECT_NAME="mundial-2026-predictor"
PROJECT_AUTHOR="Jorge Enrique Santander Fernandez"
PROJECT_VERSION="0.1.0"
