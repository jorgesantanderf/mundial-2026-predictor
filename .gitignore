# ==============================================================================
# Mundial 2026 Predictor - .gitignore
# ==============================================================================

# --- Secrets & credentials (NEVER commit these) ---
.env
.env.local
.env.*.local
*.key
*.pem
credentials.json
secrets/

# --- Data files (too heavy for git, store in Drive/cloud) ---
data/raw/photos/
data/raw/videos/
data/raw/*.zip
data/raw/*.tar.gz
*.parquet
# Keep CSVs of metadata and processed features in git, but ignore huge raw data
data/raw/*.csv
!data/raw/.gitkeep
data/processed/*.csv
!data/processed/.gitkeep
data/processed/*.pkl
data/external/

# --- Models (large binary files) ---
models/*.pkl
models/*.h5
models/*.pt
models/*.bin
!models/.gitkeep

# --- Outputs ---
outputs/figures/*.png
outputs/figures/*.jpg
outputs/figures/*.pdf
outputs/figures/*.svg
!outputs/figures/.gitkeep
outputs/simulations_raw.csv

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual environments ---
venv/
env/
ENV/
.venv/
